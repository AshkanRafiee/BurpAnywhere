# .env.example - Copy this to .env and customize values

# Burp Suite Configuration
BURPSUITE_VERSION=2025.11
BURPSUITE_TYPE=community
BURPSUITE_MODE=download
BURPSUITE_HOME=/home/burp

# Java Configuration (JVM Options for performance tuning)
JAVA_OPTS=-Dawt.useSystemAAFontSettings=gasp -Dswing.aatext=true -Dsun.java2d.xrender=true -XX:+UnlockExperimentalVMOptions -XshowSettings:vm

# Display Configuration (for X11 forwarding)
DISPLAY=host.docker.internal:0

# Browser / VNC Access
ENABLE_WEB_UI=true
VNC_DISPLAY=:1
VNC_PORT=5901
NOVNC_PORT=6080
NOVNC_WEB_DIR=/usr/share/novnc
XVFB_GEOMETRY=1920x1080x24
VNC_PASSWORD=burp

# Burp Proxy Configuration
BURP_PROXY_PORT=8080

# Configuration Files (relative paths inside container)
PROJECT_CONFIG_FILE=config/project_options.json
USER_CONFIG_FILE=config/user_options.json

# Restart behavior configuration
RESTART_ON_EXIT=true
RESTART_DELAY=2
RESTART_MAX=0

# ============================================
# BURPSUITE_MODE Options:
# - download: Automatically downloads Burp Suite from portswigger.net
# - local: Uses ./burpsuite.jar that you supply before building
# ============================================